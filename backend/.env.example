# ===========================================================================
# Blindspot ECDAT — backend environment template
# ===========================================================================
#
# Copy to .env and fill in your own values:
#     Copy-Item .env.example .env
#
# .env is gitignored. NEVER commit real credentials or a service account file.

# --- Application -----------------------------------------------------------
# development | production
# Fail-closed: if this variable is unset, the app defaults to 'production'
# (authentication stays enforced). Set it to 'development' explicitly for local
# work. Only 'development' permits the AUTH_DISABLED escape hatch below.
BLINDSPOT_ENV=development

# Comma-separated origins allowed to call the API (the Vite dev server).
BLINDSPOT_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173


# --- Firebase (required from Phase 2 onward) -------------------------------
# Firebase console -> Project settings -> General -> Project ID
FIREBASE_PROJECT_ID=

# Absolute path to the service account JSON.
# Firebase console -> Project settings -> Service accounts
#   -> "Generate new private key"
#
# Store this file OUTSIDE the repository, or rely on .gitignore, which already
# excludes *serviceAccount*.json and *firebase-adminsdk*.json.
# Example: C:\Users\you\.secrets\blindspot-firebase-adminsdk.json
FIREBASE_CREDENTIALS_PATH=

# Firebase console -> Storage. Looks like <project-id>.firebasestorage.app
# (older projects use <project-id>.appspot.com).
FIREBASE_STORAGE_BUCKET=


# --- Local development escape hatch ----------------------------------------
# Bypasses Firebase token verification and runs every request as a clearly
# labelled demo principal. Useful before Firebase is set up.
#
# Fail-closed: honoured ONLY when BLINDSPOT_ENV=development. Any other value
# (production, staging, empty, unset) refuses the bypass and enforces auth.
# Enabling the bypass therefore takes two deliberate local-only settings.
AUTH_DISABLED=false


# --- Scanning --------------------------------------------------------------
# Seeded repository the demo scans. Defaults to <repo-root>/demo-repo.
# DEMO_REPO_PATH=

# Semgrep executable. Leave as-is when the venv is active.
SEMGREP_PATH=semgrep

# Hard timeout for one semgrep invocation, in seconds. Set to 0 (the
# default) to let scans run to completion regardless of duration.
SEMGREP_TIMEOUT_SECONDS=0


# --- Repository URL ingestion ----------------------------------------------
# A scan target may be a remote git repository URL. The server clones it, so
# this is an SSRF-sensitive boundary: cloning is HTTPS-only and restricted to
# the host allowlist below. `git` must be installed and on PATH (or set GIT_PATH).
GIT_PATH=git

# Shallow-clone depth for repository-URL scans.
GIT_CLONE_DEPTH=1

# Hard timeout for a single git clone, in seconds. Set to 0 (the default)
# to let large public repositories clone to completion on slow links.
REPO_CLONE_TIMEOUT_SECONDS=0

# Comma-separated allowlist of hosts permitted for repository-URL scans.
# Exact host or a subdomain of an allowed host is accepted.
ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org


# --- Mosca risk model ------------------------------------------------------
# Z: estimated years until a cryptographically relevant quantum computer.
#
# This is an ASSUMPTION, not a fact. It stays configurable, and its provenance
# is reported alongside every calculation so the number is never presented as
# settled science.
QUANTUM_HORIZON_YEARS=10
QUANTUM_HORIZON_SOURCE=Demo assumption (configurable via QUANTUM_HORIZON_YEARS)

# Y: default organisational migration time in years.
MIGRATION_TIME_YEARS=3


# --- Artefacts -------------------------------------------------------------
# Local directory for generated CBOM and report files.
# ARTIFACTS_DIR=

# Cached last-successful scan backing the demo fallback mode.
# FALLBACK_CACHE_PATH=


# --- Live cloud KMS attestation --------------------------------------------
# Optional attestation scanners for AWS KMS, Azure Key Vault, and GCP KMS.
# All three are opt-in and gracefully degrade to an empty finding list when
# their SDK is not installed. Each scanner uses the vendor's standard
# credential chain (AWS: env/shared config/IAM role, Azure:
# DefaultAzureCredential, GCP: application-default credentials).
#
# ---- AWS KMS ----
AWS_KMS_SCAN_ENABLED=false
# Empty falls back to boto3's default region resolution.
AWS_KMS_REGION=
AWS_KMS_MAX_KEYS=100

# ---- Azure Key Vault ----
# Install:  pip install azure-keyvault-keys azure-identity
AZURE_KV_SCAN_ENABLED=false
AZURE_KV_VAULT_URL=
AZURE_KV_MAX_KEYS=100

# ---- GCP KMS ----
# Install:  pip install google-cloud-kms
GCP_KMS_SCAN_ENABLED=false
GCP_KMS_PROJECT=
GCP_KMS_LOCATION=global
GCP_KMS_MAX_KEYS=100


# --- Storage backend -------------------------------------------------------
# Where scan artefacts are persisted:
#
#   auto     - use Firebase when FIREBASE_PROJECT_ID + FIREBASE_CREDENTIALS_PATH
#              resolve to a real service account file, otherwise fall back to
#              the local filesystem. This is the default and matches the demo.
#   local    - on-prem / air-gapped mode. NEVER contacts Firebase. Every scan
#              lands in ARTIFACTS_DIR and FALLBACK_CACHE_PATH only. Use this
#              in deployments where scan data must not leave the network.
#   firebase - require Firebase to be reachable. Warnings are noisy when it
#              is not, instead of silently degrading.
#
# The local filesystem mirror is ALWAYS written, regardless of this setting,
# so a Firebase failure never loses a scan.
STORAGE_BACKEND=auto
