# ===========================================================================
# Blindspot ECDAT — frontend environment template
# ===========================================================================
#
# Copy to .env and fill in your own values:
#     Copy-Item .env.example .env
#
# Vite only exposes variables prefixed with VITE_ to client code.
#
# Firebase web config values are NOT secrets — they ship in the client bundle
# by design, and access is controlled by Firebase Security Rules, not by hiding
# these strings. They are still environment specific, so .env stays gitignored.
#
# The backend service account key is a real secret. It never appears here.

# --- Backend ---------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8000


# --- Firebase Web SDK (required from Phase 2 onward) -----------------------
# Firebase console -> Project settings -> General
#   -> "Your apps" -> Web app -> SDK setup and configuration -> Config
#
# If no web app exists yet, click "Add app" and choose the web platform.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
