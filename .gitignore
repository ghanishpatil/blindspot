# ---------------------------------------------------------------------------
# Blindspot ECDAT - repository ignore rules
# ---------------------------------------------------------------------------

# --- Secrets / credentials (NEVER commit) ----------------------------------
.env
.env.*
!.env.example
*serviceAccount*.json
*service-account*.json
*firebase-adminsdk*.json
*.pem
*.key
secrets/
credentials/

# --- External / cloned repositories under test -----------------------------
# Repos cloned for scanning (paramiko, openssl, etc.) are not part of this
# project and must never be committed.
test-repos/
scan-targets/

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Python tooling caches -------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.tox/
.nox/
.hypothesis/

# --- Semgrep ---------------------------------------------------------------
.semgrep/
.semgrep_logs/

# --- Node / frontend -------------------------------------------------------
node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.eslintcache
frontend/dist/
frontend/build/
frontend/.vite/
frontend/node_modules/
*.local

# --- Generated demo artefacts ---------------------------------------------
# Generated CBOMs / reports produced by scan runs.
backend/artifacts/
backend/.artifacts/
backend/.scan-work/
.scan-work/
backend/.diag.txt
backend/.imgscan.txt
backend/.imgscan.*
backend/app/data/cache/*.json
!backend/app/data/cache/.gitkeep

# --- Logs ------------------------------------------------------------------
*.log
logs/

# --- Editors / OS ----------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
